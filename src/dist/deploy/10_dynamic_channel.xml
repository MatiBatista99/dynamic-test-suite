<?xml version="1.0" ?>

<channel-adaptor name='dynamic-channel'
                 class="ar.cabal.DynamicChannelAdaptor" logger="Q2">
    <channel origin="@origin@" logger="Q2" realm="DYNAMIC-CHANNEL"
             header="P180ISO026000000">
        <property name="host" value="@10_channel_host@" />
    </channel>
    <in>dynamic-channel-send</in>
    <out>dynamic-channel-receive</out>
    <reconnect-delay>10000</reconnect-delay>
</channel-adaptor>
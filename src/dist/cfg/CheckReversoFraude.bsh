package ar.cabal.jpos;

import org.jpos.transaction.Context;
import org.jpos.ee.TranLog;
import org.jpos.iso.ISOException;
import org.jpos.ee.DB;
import org.jpos.ee.ActionCode;
import org.jpos.iso.ISOException;
import org.jpos.iso.ISOMsg;
import org.jpos.util.Log;
import java.util.List;
import org.jpos.util.LogEvent;

    public synchronized DB getDB (Context ctx) {
        DB db = (DB) ctx.get (DB);
        if (db == null) {
            ctx.put (DB, db = new DB ());
        }
        return db;
    }

        ISOMsg m = (ISOMsg) ctx.get(SS_REQUEST);
        TranLog tl = (TranLog) ctx.get(TRANLOG);

        List lista = new ArrayList();
        lista.add("6042096");
        lista.add("6042097");
        if (CabalUtil.isReverse(m) && "LINK_SS".equals(ctx.get(SS)) && lista.contains(m.getString(35).substring(0,7)) && "22".equals(tl.getIncomingResponseCode())){        
            CabalUtil.setRejectionReason(ctx, RECHAZO_MODULO_FRAUDES, getDB(ctx), new LogEvent(this, "RejectionReason"), false);
            return ABORTED;
        }
        return PREPARED | NO_JOIN;



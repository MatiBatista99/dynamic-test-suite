package ar.cabal.jpos;

import org.jpos.space.Space;
import ar.cabal.jpos.space.SpaceFactory;
import org.jpos.iso.ISOMsg;
import org.jpos.util.LogEvent;
import org.jpos.iso.ISOException;

    private boolean isReverse(ISOMsg m) throws ISOException {
        return m.getMTI().equals("0410");
    }

        ISOMsg m = (ISOMsg) message.clone();

        if (isReverse(message)) {
            m.set(39, "00");//Enviamos los reversos siempre "aprobados"
        }

        evt.addMessage("--- filtered message (coto_fixe_outgoing) --");
        evt.addMessage(m);
        message = m;

package ar.cabal.jpos;

import org.jpos.transaction.Context;
import org.jpos.ee.TranLog;
import org.jpos.iso.ISOException;
import org.jpos.ee.DB;
import org.jpos.ee.ActionCode;
import org.jpos.iso.ISOException;
import org.jpos.util.LogEvent;

    public synchronized DB getDB (Context ctx) {
        DB db = (DB) ctx.get (DB);
        if (db == null) {
            ctx.put (DB, db = new DB ());
        }
        return db;
    }

        String pan = (String) ctx.get(PAN);

        if (CabalUtil.checkDigit(pan)){
                return PREPARED | NO_JOIN;
        }
        CabalUtil.setRejectionReason(ctx, INVALID_CARD, getDB(ctx), new LogEvent(this, "RejectionReason"), false);
        return ABORTED;
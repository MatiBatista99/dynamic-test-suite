package ar.cabal.jpos;

import org.jpos.space.Space;
import ar.cabal.jpos.space.SpaceFactory;
import org.jpos.iso.ISOMsg;
import org.jpos.util.LogEvent;

        ISOMsg m = (ISOMsg) message.clone();

        String cuotas = message.getString(48).substring(7, 9);
        String plan = String.valueOf(message.getString(48).charAt(6));
        if ("07".equals(cuotas) || "08".equals(cuotas) || "13".equals(cuotas) || "16".equals(cuotas)){
            if ("07".equals(cuotas)){
                cuotas = "12";
            }
            if ("08".equals(cuotas)){
                cuotas = "18";
            }
            if ("13".equals(cuotas) || "16".equals(cuotas)){
                cuotas = "0" + cuotas.substring(1);
            }
            m.set(48,message.getString(48).substring(0,6) + "7" + cuotas + message.getString(48).substring(9));
        }

        evt.addMessage("--- filtered message (visa_ahora3y6_outgoing) --");
        evt.addMessage(m);
        message = m;

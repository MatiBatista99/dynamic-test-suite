    private boolean inPanList(ISOMsg m) {
        String tokenFields = cfg.get("pan-list","");
        StringTokenizer tokenizer = new StringTokenizer(tokenFields, ", ");
        CardHolder ch = new CardHolder(m);
        String pan = ch.getPAN();
        while (tokenizer.hasMoreTokens()) {
            String token = tokenizer.nextToken();
            String bin = pan.substring(0, token.length());
            if (token.equals(bin)) {
                return true;
            }
        }
        return false;
    }
    
    public static boolean isAcquirerBins() {
        binRangeDebitoEMV = cfg.get("debito-emv", "650087");
        binRangeCreditoEMV = cfg.get("credito-emv", "650272");
        binRangeDinners = cfg.get("dinners", "36");
        if (m.hasField(2)) {
            pan = m.getString(2);
        } else if (m.hasField(35) && m.getString(35).startsWith(binRangeDinners)) {
            pan = m.getString(35).substring(0, 14);
        } else if (m.hasField(35)) {
            pan = m.getString(35).substring(0, 16);
        }
        return pan.startsWith(binRangeDinners)
            || ((pan.startsWith("65") || pan.startsWith("6011") || pan.startsWith("6440")) 
            && !pan.startsWith(binRangeDebitoEMV) && !pan.startsWith(binRangeCreditoEMV));
    }

    private boolean isDiscover(ISOMsg m) {
        if (isAcquirerBins() && isOchoDigitos(m)) {
                String merch = m.getString(42).trim();
                String merch11 = "893" + merch; // Se agrega el prefijo "893" al merchantId cuando son tx de acq y tiene 8 dígitos.
                 m.set(42, ISOUtil.padright(merch11, 15, ' '));
                 return true;
        }
        return false;
    }

    private boolean isOchoDigitos(ISOMsg m) {
        return m.getString(42).trim().length() == 8;
    }

        ISOMsg m = message; // Sacamos el clone() para que no cambie el hashcode del mensaje.
        evt.addMessage("--- original message (ss_pvs_incoming_fix) --");

        try {
            if (!"2800".equals(m.getMTI()) && !"0800".equals(m.getMTI()) && m.isRequest()){
                if (m.hasField(42)) {
                    if (!inPanList(m) && isOchoDigitos(m) && !isAcquirerBins()) {
                        String merch = m.getString(42).trim();
                        String merch11 = "889" + merch;//Llevo el comercio a 11 posiciones con el prefijo 889 si no pertenece a los comercios configurados (Kadicard)
                        m.set(42, ISOUtil.padright(merch11, 15, ' '));
                    }else{
                        evt.addMessage("Validamos si es bin discover");
                        isDiscover(m);
                    }
                }
            }
            if (m.hasField("43.2") && "".equals(m.getString("43.2").trim())){
                m.set("43.2","NONE ");
                m.set("43.4","NONE         ");
                m.set("43.5","  ");
                m.set("43.7","AR");
            }
        } catch (Exception e) {
            evt.addMessage("--- ss_pvs_incoming_fix ---");
            evt.addMessage(e);
        }
        return m;
